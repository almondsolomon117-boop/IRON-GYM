# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
# Get these from your Supabase project dashboard:
# https://supabase.com/dashboard → your project → Settings → API

# Supabase Project URL (found in Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (found in Settings → API → Project API keys → public anon)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (found in Settings → API → Project API keys → service_role secret)
# Only needed for server-side admin operations — NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===========================================
# DATABASE (Supabase PostgreSQL via Prisma)
# ===========================================
# Connection pooler URL (recommended for serverless)
# Found in Settings → Database → Connection string → URI (tab "Transaction pooler")
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=15

# Direct connection URL (needed for migrations)
# Found in Settings → Database → Connection string → URI (tab "Session")
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].supabase.com:5432/postgres

# ===========================================
# AUTH (JWT)
# ===========================================
JWT_SECRET=your-jwt-secret-change-this-to-a-long-random-string
